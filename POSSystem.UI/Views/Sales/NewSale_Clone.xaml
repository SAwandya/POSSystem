<Window x:Class="POSSystem.UI.Views.Sales.NewSaleClone"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="New Sale - Create Invoice"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#FF0F0F1A"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip"
        Height="850"
        d:DesignWidth="835.463">

    <Window.Resources>
        <!-- Color Palette -->
        <SolidColorBrush x:Key="PrimaryPurple" Color="#FF8B5DFF"/>
        <SolidColorBrush x:Key="SecondaryBlue" Color="#FF3D8BFF"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#FF00E096"/>
        <SolidColorBrush x:Key="WarningYellow" Color="#FFFFD166"/>
        <SolidColorBrush x:Key="ErrorRed" Color="#FFFF5E7C"/>

        <!-- Dark Theme -->
        <SolidColorBrush x:Key="DarkBackground" Color="#FF0F0F1A"/>
        <SolidColorBrush x:Key="DarkCard" Color="#FF1A1A2E"/>
        <SolidColorBrush x:Key="DarkSurface" Color="#FF252540"/>
        <SolidColorBrush x:Key="DarkBorder" Color="#FF3A3A5E"/>

        <!-- Text Colors -->
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFB0B0D0"/>

        <!-- Sale Page Styles -->
        <Style x:Key="SaleTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource DarkSurface}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DarkBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="SaleButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryPurple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource DarkBorder}"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource DarkCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DarkBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{StaticResource DarkCard}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource DarkSurface}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Black"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource DarkBorder}"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Height" Value="42"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- NEW: Payment Method RadioButton style (looks like adjacent box buttons) -->
        <Style x:Key="PaymentMethodButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource DarkBorder}"/>
            <Setter Property="Background" Value="{StaticResource DarkSurface}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Checked = purple -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryPurple}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryPurple}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryPurple}"/>
                            </Trigger>

                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="15,15,15,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Upper Header (ONLY HEADER NOW) -->
        <Border Grid.Row="0"
                Background="{StaticResource DarkSurface}"
                CornerRadius="3"
                Padding="12"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left side info -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧾 Invoice Mode"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,15,0"/>

                    <TextBlock Text="Retail Sale"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right side actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnSaveHold"
                            Content="💾 Save &amp; Hold"
                            Style="{StaticResource SecondaryButton}"
                            Height="38"
                            Width="140"
                            Margin="0,0,10,0"
                            Click="SaveHoldButton_Click"/>

                    <Button Content="Dashboard"
                            Style="{StaticResource SecondaryButton}"
                            Height="38"
                            Width="130"
                            Margin="0,0,10,0"
                            Click="Button_Click"/>

                    <Button Content="🔄 Refresh"
                            Style="{StaticResource SecondaryButton}"
                            Height="38"
                            Width="120"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE -->
            <Grid Grid.Column="0" Margin="0,0,15,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Product Entry Section (COMPACT) -->
                <Border Grid.Row="0"
                        Background="{StaticResource DarkCard}"
                        CornerRadius="16"
                        Padding="15"
                        Margin="0,0,0,10">

                    <StackPanel>

                        <!-- Invoice Info Row -->

                        <Border Background="{StaticResource DarkSurface}"
        CornerRadius="12"
        Padding="12"
        Margin="0,0,0,12"
        BorderBrush="{StaticResource DarkBorder}"
        BorderThickness="1">

                            <Grid>
                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>



                                <!-- Invoice Number + Time -->
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Invoice No"
               FontSize="10"
               Foreground="{StaticResource TextSecondary}"
               Margin="0,0,0,4"/>

                                    <TextBlock x:Name="txtInvoiceNumber"
               Text="INV-000001"
               FontSize="20"
               FontWeight="Bold"
               Foreground="{StaticResource TextPrimary}"
               
               Margin="0,-2,0,0"/>

                                    <!-- Time under invoice number -->
                                    <TextBlock x:Name="txtTime"
               Text="10:45 AM"
               FontSize="11"
               FontWeight="SemiBold"
               Foreground="{StaticResource TextSecondary}"
               Margin="0,2,0,0"/>
                                </StackPanel>



                                <!-- Date -->
                                <StackPanel HorizontalAlignment="Right" Width="170" Grid.Column="1">
                                    <TextBlock Text="Date"
               FontSize="10"
               Foreground="{StaticResource TextSecondary}"
               Margin="0,0,0,4"/>

                                    <Border Background="{StaticResource DarkSurface}"
            BorderBrush="{StaticResource DarkBorder}"
            BorderThickness="1"
            CornerRadius="10"
            Height="42"
            Padding="10,0">

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>



                                            <!-- DatePicker -->
                                            <DatePicker x:Name="dpSaleDate"
                        Grid.Column="1"
                        Background="Transparent"
                        Foreground="White"
                        BorderThickness="0"
                        VerticalAlignment="Center"
                        Height="40">
                                                <DatePicker.Resources>
                                                    <Style TargetType="DatePickerTextBox">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="0"/>
                                                        <Setter Property="FontSize" Value="13"/>
                                                    </Style>
                                                </DatePicker.Resources>
                                            </DatePicker>
                                        </Grid>
                                    </Border>
                                </StackPanel>



                            </Grid>
                        </Border>

                        <!-- Product Search Row -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="3.2*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Item Code -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Item Code" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtItemCode" Style="{StaticResource SaleTextBox}"/>
                            </StackPanel>

                            <!-- Search Product -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Search Product (Barcode/Name/ID)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>

                                <Grid>
                                    <TextBox x:Name="txtProductSearch"
                                             Style="{StaticResource SaleTextBox}"
                                             TextChanged="ProductSearch_TextChanged"
                                             KeyDown="ProductSearch_KeyDown"
                                             GotFocus="ProductSearch_GotFocus"
                                             LostFocus="ProductSearch_LostFocus"
                                             Text=""/>

                                    <!-- Product Suggestions Popup -->
                                    <Popup x:Name="ProductSuggestionsPopup"
                                           PlacementTarget="{Binding ElementName=txtProductSearch}"
                                           Placement="Bottom"
                                           IsOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Slide"
                                           StaysOpen="False">
                                        <Border Background="{StaticResource DarkSurface}"
                                                BorderBrush="{StaticResource DarkBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                MaxHeight="300"
                                                MinWidth="{Binding ElementName=txtProductSearch, Path=ActualWidth}">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                <ItemsControl x:Name="ProductSuggestionsList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="12,8"
                                                                    Cursor="Hand"
                                                                    MouseLeftButtonDown="SuggestionItem_Click">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="{StaticResource PrimaryPurple}"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>

                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding ProductId}"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               Foreground="{StaticResource TextSecondary}"
                                                                               Margin="0,0,10,0"
                                                                               VerticalAlignment="Center"/>

                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontSize="13"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource TextPrimary}"/>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock Text="Barcode: " FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                                                            <TextBlock Text="{Binding Barcode}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                                                            <TextBlock Text=" | Price: Rs " FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                                                            <TextBlock Text="{Binding SellingPrice, StringFormat='{}{0:#,##0.00}'}"
                                                                                       FontSize="10"
                                                                                       Foreground="{StaticResource TextSecondary}"/>
                                                                        </StackPanel>
                                                                    </StackPanel>

                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding AvailableQty, StringFormat='Stock: {0}'}"
                                                                               FontSize="11"
                                                                               Foreground="{StaticResource SuccessGreen}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="10,0,0,0"/>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Quantity" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtQuantity" Text="1" Style="{StaticResource SaleTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                <TextBlock Text="Label Price" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtlabelprice" Style="{StaticResource SaleTextBox}" IsReadOnly="True" Background="#30000000"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Rate" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="rate" Style="{StaticResource SaleTextBox}" IsReadOnly="True" Background="#30000000"/>
                            </StackPanel>
                        </Grid>

                        <!-- next info row -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Supplier (/search)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SupplierName" Style="{StaticResource SaleTextBox}" IsReadOnly="True" Background="#30000000"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Category (/search)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="Category" Style="{StaticResource SaleTextBox}" IsReadOnly="True" Background="#30000000"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <TextBlock Text="Cost" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="Cost" Style="{StaticResource SaleTextBox}" IsReadOnly="True" Background="#30000000"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Margin="0,0,10,0">
                                <TextBlock Text="Discount" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                <TextBox x:Name="Discount" Style="{StaticResource SaleTextBox}"  Background="#30000000"/>
                            </StackPanel>

                            <Button Grid.Column="4"
                                    Content="➕ Add Item"
                                    Style="{StaticResource SaleButton}"
                                    VerticalAlignment="Bottom"
                                    Height="45"
                                    Click="AddItemButton_Click"/>
                        </Grid>

                        <!-- CUSTOMER ROW REMOVED (SPACE KEPT FREE FOR LATER) -->

                    </StackPanel>
                </Border>

                <!-- Items Grid -->
                <Border Grid.Row="1"
                        Background="{StaticResource DarkCard}"
                        CornerRadius="16"
                        Padding="15">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Sale Items"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimary}"
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="dgSaleItems"
                                  Grid.Row="1"
                                  Style="{StaticResource DataGridStyle}"
                                  Margin="0,0,0,10">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Width="50" Binding="{Binding SNo}"/>
                                <DataGridTextColumn Header="Product Name" Width="*" Binding="{Binding ProductName}"/>
                                <DataGridTextColumn Header="Unit Price" Width="120" Binding="{Binding UnitPrice, StringFormat='Rs {0:#,##0.00}'}"/>
                                <DataGridTextColumn Header="Qty" Width="80" Binding="{Binding Quantity}"/>
                                <!--   <DataGridTextColumn Header="Total" Width="120" Binding="{Binding TotalPrice, StringFormat='Rs {0:#,##0.00}'}"/> -->
                                <DataGridTextColumn Header="Gross Total" Binding="{Binding GrossTotal, StringFormat='Rs {0:#,##0.00}'}" Width="100"/>
                                <DataGridTextColumn Header="Discounted Total" Binding="{Binding TotalPrice, StringFormat='Rs {0:#,##0.00}'}" Width="120"/>
                                <DataGridTemplateColumn Header="Action" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="❌ Remove"
                                                    Background="{StaticResource ErrorRed}"
                                                    Foreground="White"
                                                    BorderThickness="0"
                                                    Padding="8,4"
                                                    Cursor="Hand"
                                                    Tag="{Binding ProductId}"
                                                    Click="RemoveItem_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="🗑 Clear All"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="130"
                                    Height="42"
                                    Click="ClearAllButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT SIDE -->
            <Border Grid.Column="1"
                    Background="{StaticResource DarkCard}"
                    CornerRadius="16"
                    Padding="15">

                <Grid>
                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Payment Section -->
                    <Border Grid.Row="0"
                            Background="{StaticResource DarkSurface}"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Payment"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,10"/>

                            <!-- NEW STRUCTURE -->
                            <!-- Payment Type -->
                            <TextBlock Text="Payment Type"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,4"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <RadioButton x:Name="rbOnDay"
                                             Content="📅 On Day"
                                             Foreground="{StaticResource TextPrimary}"
                                             Margin="0,0,15,0"
                                             GroupName="PaymentType"
                                             IsChecked="True"/>

                                <RadioButton x:Name="rbCredit"
                                             Content="🧾 Credit"
                                             Foreground="{StaticResource TextPrimary}"
                                             Margin="0,0,0,0"
                                             GroupName="PaymentType"/>
                            </StackPanel>

                            <!-- Payment Method -->
                            <TextBlock Text="Payment Method"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,4"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <RadioButton x:Name="rbCash"
                                             Grid.Column="0"
                                             Content="💵 Cash"
                                             Style="{StaticResource PaymentMethodButtonStyle}"
                                             GroupName="PaymentMethod"
                                             IsChecked="True"
                                             Margin="0,0,6,0"/>

                                <RadioButton x:Name="rbCard"
                                             Grid.Column="1"
                                             Content="💳 Card"
                                             Style="{StaticResource PaymentMethodButtonStyle}"
                                             GroupName="PaymentMethod"
                                             Margin="0,0,6,0"/>

                                <RadioButton x:Name="rbTransfer"
                                             Grid.Column="2"
                                             Content="🏦 Transfer"
                                             Style="{StaticResource PaymentMethodButtonStyle}"
                                             GroupName="PaymentMethod"
                                             Margin="0,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Amount Paid"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondary}"
                                       Margin="0,0,0,4"/>

                            <TextBox x:Name="txtAmountPaid"
                                     Text="0.00"
                                     Style="{StaticResource SaleTextBox}"
                                     TextChanged="AmountPaid_TextChanged"/>

                            <Grid Margin="0,8,0,0">
                                <TextBlock Text="Change:" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="txtChange" Text="Rs 0.00" FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Bill Summary -->
                    <Border Grid.Row="1"
                            Background="{StaticResource DarkSurface}"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Bill Summary" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Total Items:" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="txtItemCount" Text="0" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Subtotal:" FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock x:Name="txtSubTotal" Text="Rs 0.00" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"/>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Discount (%)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtDiscountPercent" Text="0" Style="{StaticResource SaleTextBox}" Height="38" TextChanged="Discount_TextChanged"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Tax (%)" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                    <TextBox x:Name="txtTaxPercent" Text="0" Style="{StaticResource SaleTextBox}" Height="38" TextChanged="Tax_TextChanged"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Discount:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="txtDiscountAmount" Text="Rs 0.00" FontSize="11" Foreground="{StaticResource ErrorRed}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Tax:" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock x:Name="txtTaxAmount" Text="Rs 0.00" FontSize="11" Foreground="{StaticResource WarningYellow}"/>
                                </StackPanel>
                            </Grid>

                            <Rectangle Height="1" Fill="{StaticResource DarkBorder}" Margin="0,5,0,10"/>

                            <Grid>
                                <TextBlock Text="GRAND TOTAL:" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock x:Name="txtGrandTotal" Text="Rs 0.00" FontSize="17" FontWeight="Bold"
                                           Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Spacer -->
                    <Grid Grid.Row="2">

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="2">
                            <Button Content="✅ Complete Sale"
                                Style="{StaticResource SaleButton}"
                                Height="55"
                                FontSize="16"
                                Click="CompleteSaleButton_Click"
                                Margin="0,0,0,8"/>

                            <Button Content="🖨 Print Preview"
                                Style="{StaticResource SecondaryButton}"
                                Height="45"
                                Click="PrintPreviewButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
