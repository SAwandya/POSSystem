<Window x:Class="POSSystem.UI.Views.GRN.AddItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Add New Item"
        Width="1400"
        Height="900"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E2E"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Add this converter to fix XDG0006 -->
        <BooleanToVisibilityConverter x:Key="BooleanToNotConverter"/>
        
        <!-- Color Palette -->
        <SolidColorBrush x:Key="PrimaryPurple" Color="#FF8B5DFF"/>
        <SolidColorBrush x:Key="SecondaryBlue" Color="#FF3D8BFF"/>
        <SolidColorBrush x:Key="SuccessGreen" Color="#FF00E096"/>
        <SolidColorBrush x:Key="WarningYellow" Color="#FFFFD166"/>
        <SolidColorBrush x:Key="ErrorRed" Color="#FFFF5E7C"/>

        <!-- Dark Theme -->
        <SolidColorBrush x:Key="DarkBackground" Color="#FF1E1E2E"/>
        <SolidColorBrush x:Key="DarkCard" Color="#FF2A2A3E"/>
        <SolidColorBrush x:Key="DarkSurface" Color="#FF2A2A3E"/>
        <SolidColorBrush x:Key="DarkBorder" Color="#FF3A3A5E"/>

        <!-- Text Colors -->
        <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#FFB0B0D0"/>
        <SolidColorBrush x:Key="CyanColor" Color="#FF00E0FF"/>
        <SolidColorBrush x:Key="GreenColor" Color="#FF00E096"/>
        <SolidColorBrush x:Key="OrangeColor" Color="#FFFFA726"/>

        <!-- Styles -->
        <Style x:Key="InputBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#FFCCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ReadOnlyInputBox" TargetType="TextBox" BasedOn="{StaticResource InputBoxStyle}">
            <Setter Property="Background" Value="#FFEEEEEE"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF8B5DFF" Offset="0"/>
                        <GradientStop Color="#FF7B4DFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,0"/>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFF5E7C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="AddItemButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF00E096" Offset="0"/>
                        <GradientStop Color="#FF00D086" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#FF3D8BFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFF5E7C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FF2A2A3E"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="#FF3A3A5E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#FF2A2A3E"/>
            <Setter Property="AlternatingRowBackground" Value="#FF252540"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#FF3A3A5E"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                        <Setter Property="BorderBrush" Value="#FF3A3A5E"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Height" Value="35"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Highlight style for selected row in search results -->
        <Style x:Key="SearchResultRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#403D8BFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF8B5DFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Header -->
        <Border Background="#FF2A2A3E" BorderBrush="#FF3A3A5E" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Add New Item" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"/>
                    <TextBlock Text="Goods Received Note - Add Item" 
                               FontSize="12" 
                               Foreground="#FFB0B0D0"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnSave" 
                            Content="Save Item" 
                            Style="{StaticResource HeaderButton}"
                            Click="BtnSave_Click"/>
                    <Button x:Name="btnClose" 
                            Style="{StaticResource CloseButton}"
                            Margin="8,0,0,0"
                            Click="BtnClose_Click">
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top Info Row -->
            <Border Grid.Row="0" 
                    Background="#FF2A2A3E" 
                    CornerRadius="8" 
                    BorderBrush="#FF3A3A5E" 
                    BorderThickness="1"
                    Padding="16"
                    Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- GRN Number -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="GRN Number" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="White"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="txtGRNNumber" 
                                 Text="GRN-2026-001"
                                 Style="{StaticResource ReadOnlyInputBox}"/>
                    </StackPanel>

                    <!-- Date -->
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Date" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="White"
                                   Margin="0,0,0,4"/>
                        <DatePicker x:Name="dpDate" 
                                   
                                    Height="32"
                                    FontSize="13"/>
                    </StackPanel>

                    <!-- Supplier -->
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Supplier" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="White"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="cmbSupplier" 
                                  Height="32"
                                  FontSize="13"/>
                    </StackPanel>

                    <!-- Supplier Invoice No -->
                    <StackPanel Grid.Column="3" Margin="0,0,8,0">
                        <TextBlock Text="Supplier Invoice No" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="White"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="txtSupplierInvoiceNo" 
                                 Text="INV-####"
                                 Style="{StaticResource InputBoxStyle}"/>
                    </StackPanel>

                    <!-- Items Added -->
                    <StackPanel Grid.Column="4" Margin="0,0,8,0">
                        <TextBlock Text="Items Added" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="White"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="txtItemsAdded" 
                                 Text="0"
                                 Style="{StaticResource ReadOnlyInputBox}"
                                 Background="#FF006064"
                                 Foreground="#FF00E0FF"
                                 FontWeight="Bold"
                                 TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Total -->
                    <StackPanel Grid.Column="5">
                        <TextBlock Text="Total" 
                                   FontSize="11" 
                                   FontWeight="SemiBold" 
                                   Foreground="White"
                                   Margin="0,0,0,4"/>
                        <Border Background="#FF006400"
                                BorderBrush="#FF00E096"
                                BorderThickness="1"
                                CornerRadius="4"
                                Height="32"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="txtTotal" 
                                     Text="$0.00"
                                     Foreground="#FF00E096"
                                     FontWeight="Bold"
                                     FontSize="12"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Item Entry Row -->
            <Border Grid.Row="1" 
                    Background="#FF2A2A3E" 
                    CornerRadius="8" 
                    BorderBrush="#FF3A3A5E" 
                    BorderThickness="1"
                    Padding="16"
                    Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Add New Item" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="White"
                               Margin="0,0,0,8"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Item Code -->
                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                            <TextBlock Text="Item Code" 
                                       FontSize="10" 
                                       FontWeight="SemiBold" 
                                       Foreground="White"
                                       Margin="0,0,0,2"/>
                            <TextBox x:Name="txtItemCode" 
                                     Style="{StaticResource InputBoxStyle}"
                                     FontSize="12"/>
                        </StackPanel>

                        <!-- Item Name -->
                        <StackPanel Grid.Column="1" Margin="0,0,4,0">
                            <TextBlock Text="Item Name" 
                                       FontSize="10" 
                                       FontWeight="SemiBold" 
                                       Foreground="White"
                                       Margin="0,0,0,2"/>
                            <TextBox x:Name="txtItemName" 
                                     Style="{StaticResource InputBoxStyle}"
                                     FontSize="12"
                                     KeyDown="TxtItemName_KeyDown"
                                     TextChanged="TxtItemName_TextChanged"/>
                        </StackPanel>

                        <!-- Subcategory -->
                        <StackPanel Grid.Column="2" Margin="0,0,4,0">
                            <TextBlock Text="Subcategory" 
                                       FontSize="10" 
                                       FontWeight="SemiBold" 
                                       Foreground="White"
                                       Margin="0,0,0,2"/>
                            <TextBox x:Name="txtSubcategory" 
                                     Style="{StaticResource ReadOnlyInputBox}"
                                     FontSize="12"/>
                        </StackPanel>

                        <!-- Unit -->
                        <StackPanel Grid.Column="3" Margin="0,0,4,0">
                            <TextBlock Text="Unit" 
                                       FontSize="10" 
                                       FontWeight="SemiBold" 
                                       Foreground="White"
                                       Margin="0,0,0,2"/>
                            <TextBox x:Name="txtUnit" 
                                     Text="PCS"
                                     Style="{StaticResource ReadOnlyInputBox}"
                                     FontSize="12"/>
                        </StackPanel>

                        <!-- Quantity -->
                        <StackPanel Grid.Column="4" Margin="0,0,4,0">
                            <TextBlock Text="Qty" 
                                       FontSize="10" 
                                       FontWeight="SemiBold" 
                                       Foreground="White"
                                       Margin="0,0,0,2"/>
                            <TextBox x:Name="txtQuantity" 
                                     Text="1"
                                     Style="{StaticResource InputBoxStyle}"
                                     FontSize="12"
                                     TextAlignment="Center"/>
                        </StackPanel>

                        <!-- Cost Price -->
                        <StackPanel Grid.Column="5" Margin="0,0,4,0">
                            <TextBlock Text="Cost Price" 
                                       FontSize="10" 
                                       FontWeight="SemiBold" 
                                       Foreground="White"
                                       Margin="0,0,0,2">
                                <TextBlock.ToolTip>
                                    <TextBlock Text="Slash function: Type total price followed by / to auto-calculate. Example: 500/ will divide by quantity"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBox x:Name="txtCostPrice" 
                                     Style="{StaticResource InputBoxStyle}"
                                     FontSize="12"
                                     TextAlignment="Right"
                                     TextChanged="TxtCostPrice_TextChanged"/>
                        </StackPanel>

                        <!-- Selling Price -->
                        <StackPanel Grid.Column="6" Margin="0,0,4,0">
                            <TextBlock Text="Selling Price" 
                                       FontSize="10" 
                                       FontWeight="SemiBold" 
                                       Foreground="White"
                                       Margin="0,0,0,2">
                                <TextBlock.ToolTip>
                                    <TextBlock Text="Asterisk function: Type discount % followed by * to calculate from label price. Example: 10* for 10% off"/>
                                </TextBlock.ToolTip>
                            </TextBlock>
                            <TextBox x:Name="txtSellingPrice" 
                                     Style="{StaticResource InputBoxStyle}"
                                     FontSize="12"
                                     TextAlignment="Right"
                                     TextChanged="TxtSellingPrice_TextChanged"/>
                        </StackPanel>

                        <!-- Label Price -->
                        <StackPanel Grid.Column="7" Margin="0,0,4,0">
                            <TextBlock Text="Label Price" 
                                       FontSize="10" 
                                       FontWeight="SemiBold" 
                                       Foreground="White"
                                       Margin="0,0,0,2"/>
                            <TextBox x:Name="txtLabelPrice" 
                                     Style="{StaticResource ReadOnlyInputBox}"
                                     FontSize="12"
                                     TextAlignment="Right"/>
                        </StackPanel>

                        <!-- Add Button -->
                        <StackPanel Grid.Column="8" VerticalAlignment="Bottom">
                            <Button x:Name="btnAddItem" 
                                    Content="Add Item" 
                                    Style="{StaticResource AddItemButton}"
                                    Height="32"
                                    Click="BtnAddItem_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Search Info -->
                    <TextBlock x:Name="txtSearchInfo" 
                             Text="" 
                             FontSize="10" 
                             Foreground="#FF00E0FF"
                             Margin="0,4,0,0"
                             Visibility="Collapsed"/>

                    <!-- Quick Help Info -->
                    <Border Background="#FF3A3A5E" 
                            CornerRadius="4" 
                            BorderBrush="#FF4A4A6E" 
                            BorderThickness="1"
                            Margin="0,8,0,0"
                            Padding="8">
                        <StackPanel>
                            <TextBlock Text="Quick Pricing Helpers:" 
                                       FontSize="10" 
                                       FontWeight="SemiBold" 
                                       Foreground="#FF00E0FF"/>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                         FontSize="9" 
                                         Foreground="#FFFFFFFF"><Run Text="Cost Price - Slash (/):"/><LineBreak/><Run Text="Type total price + / to auto-divide by qty. "/><LineBreak/><Run Foreground="#FF00E0FF" Text="pawan fjflvfvfs fsnfs bjfnbfsbfsbfbb"/></TextBlock>
                                <TextBlock Grid.Column="1" 
                                         FontSize="9" 
                                         Foreground="#FFFFFFFF"
                                         Margin="8,0,0,0"><Run Text="Selling Price - Asterisk (*):"/><LineBreak/><Run Text="Type discount % + * to calculate from label price. "/><LineBreak/><Run Foreground="#FF00E0FF" Text="Ex: 10* on 100 label = 90.00"/></TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Items Table -->
            <Border Grid.Row="2" 
                    Background="#FF2A2A3E" 
                    CornerRadius="8" 
                    BorderBrush="#FF3A3A5E" 
                    BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" 
                            Background="#FF3A3A5E" 
                            BorderBrush="#FF3A3A5E" 
                            BorderThickness="0,0,0,1"
                            Padding="12">
                        <TextBlock Text="GRN Item Details" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" 
                                   Foreground="White"/>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid x:Name="dgItems" 
                              Grid.Row="1"
                              Style="{StaticResource DataGridStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="DgItems_MouseDoubleClick">
                        <DataGrid.Columns>
                            <!-- Item Code -->
                            <DataGridTextColumn Header="Item Code" 
                                              Width="100"
                                              Binding="{Binding ItemCode}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontFamily" Value="Consolas"/>
                                        <Setter Property="Foreground" Value="#FF00E0FF"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Item Name -->
                            <DataGridTextColumn Header="Item Name" 
                                              Width="200"
                                              Binding="{Binding ItemName}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Subcategory -->
                            <DataGridTextColumn Header="Subcategory" 
                                              Width="120"
                                              Binding="{Binding Subcategory}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFB0B0D0"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Unit -->
                            <DataGridTextColumn Header="Unit" 
                                              Width="60"
                                              Binding="{Binding Unit}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Quantity -->
                            <DataGridTemplateColumn Header="Qty" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource InputBoxStyle}"
                                                 FontSize="11"
                                                 TextAlignment="Center"
                                                 Width="60"
                                                 IsEnabled="{Binding IsSearchResult, Converter={StaticResource BooleanToNotConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Cost Price -->
                            <DataGridTemplateColumn Header="Cost Price" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding CostPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                 Style="{StaticResource InputBoxStyle}"
                                                 FontSize="11"
                                                 TextAlignment="Right"
                                                 Width="80"
                                                 IsEnabled="{Binding IsSearchResult, Converter={StaticResource BooleanToNotConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Selling Price -->
                            <DataGridTemplateColumn Header="Selling Price" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding SellingPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                 Style="{StaticResource InputBoxStyle}"
                                                 FontSize="11"
                                                 TextAlignment="Right"
                                                 Width="80"
                                                 IsEnabled="{Binding IsSearchResult, Converter={StaticResource BooleanToNotConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Label Price -->
                            <DataGridTemplateColumn Header="Label Price" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding LabelPrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F2}"
                                                 Style="{StaticResource InputBoxStyle}"
                                                 FontSize="11"
                                                 TextAlignment="Right"
                                                 Width="80"
                                                 IsEnabled="{Binding IsSearchResult, Converter={StaticResource BooleanToNotConverter}}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Available Quantity -->
                            <DataGridTextColumn Header="Avl. Qty" 
                                              Width="80"
                                              Binding="{Binding AvailableQuantity}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFB0B0D0"/>
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Amount -->
                            <DataGridTextColumn Header="Amount" 
                                              Width="100"
                                              Binding="{Binding Amount, StringFormat=C2}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF00E0FF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="TextAlignment" Value="Right"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Action" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <!--<Button Style="{StaticResource ActionButton}"
                                                    Margin="0,0,4,0"
                                                    Click="BtnPrintBarcode_Click"
                                                    Tag="{Binding}"
                                                    IsEnabled="{Binding IsSearchResult, Converter={StaticResource BooleanToNotConverter}}">
                                                <TextBlock Text="🖨️" FontSize="12"/>
                                            </Button> -->
                                            <Button Style="{StaticResource DeleteButton}"
                                                    Click="BtnDeleteItem_Click"
                                                    Tag="{Binding}"
                                                    IsEnabled="{Binding IsSearchResult, Converter={StaticResource BooleanToNotConverter}}">
                                                <TextBlock Text="✕" FontSize="12" FontWeight="Bold"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Remarks -->
            <Border Grid.Row="3" 
                    Background="#FF2A2A3E" 
                    CornerRadius="8" 
                    BorderBrush="#FF3A3A5E" 
                    BorderThickness="1"
                    Padding="16"
                    Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Remarks" 
                               FontSize="11" 
                               FontWeight="SemiBold" 
                               Foreground="White"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="txtRemarks" 
                             Style="{StaticResource InputBoxStyle}"
                             Height="60"
                             FontSize="13"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>